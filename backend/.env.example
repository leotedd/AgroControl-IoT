# =============================================================================
# AgroControl IoT — configuración del backend
# Copie este archivo como backend/.env y complete los valores marcados con <…>.
# backend/.env está en .gitignore: NUNCA lo suba al repositorio ni lo comparta.
# Compruebe la configuración con:  npm run verificar   (no muestra secretos)
# =============================================================================

NODE_ENV=development
PUERTO=3000
# Sólo loopback. El acceso remoto (ESP32, móvil) entra por el túnel HTTPS local.
HOST=127.0.0.1
# Lista exacta de orígenes web. Añada el origen HTTPS del proxy móvil cuando se conozca.
CORS_ORIGENES=http://localhost:5174,http://127.0.0.1:5174

# --- MySQL (base agrocontrol ya importada) -----------------------------------
DB_HOST=127.0.0.1
DB_PUERTO=3306
DB_USUARIO=<usuario MySQL, p. ej. root o un usuario dedicado>
DB_CONTRASENA=<contraseña MySQL>
DB_NOMBRE=agrocontrol

# --- Sesiones web ------------------------------------------------------------
# Secreto aleatorio de 32+ caracteres. Genérelo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRETO=<secreto generado>

# --- Seguridad de la bomba (contrato §10) ------------------------------------
# false = el servidor RECHAZA encender la bomba y activar AUTOMATICO.
# APAGAR funciona siempre. Mantener false durante el montaje y las pruebas.
PERMITIR_ENCENDIDO=false
# Duración máxima (s) que el servidor acepta para un encendido (1–15). Primera prueba: 5.
# Si la telemetría informa la bomba encendida más de este valor + 3 s, el servidor ordena APAGAR.
ENCENDIDO_MAX_S=5

# --- Canal del ESP32 -----------------------------------------------------------
# false = /api/v1/iot sólo por HTTPS (túnel). Es lo correcto para el ESP32 real.
# true  = además acepta HTTP SÓLO desde 127.0.0.1, para `npm run simulador`.
#         Se ignora si NODE_ENV=production.
IOT_PERMITIR_HTTP_LOCAL=false

# --- Datos iniciales (npm run db:seed) ----------------------------------------
# Sólo se usan al ejecutar el seed sobre una base vacía. La contraseña se guarda
# únicamente como hash bcrypt; puede borrar SEED_ADMIN_CONTRASENA después.
SEED_ADMIN_EMAIL=admin@agrocontrol.local
SEED_ADMIN_NOMBRE=Administrador
SEED_ADMIN_CONTRASENA=<mínimo 10 caracteres>

# Selección de motor (MySQL sigue siendo el valor por defecto local).
DB_MOTOR=mysql
# Sólo si se selecciona PostgreSQL; no se utiliza con MySQL.
# DATABASE_URL=<URL PostgreSQL del entorno autorizado>
PG_POOL_MAX=5
PG_CONNECTION_TIMEOUT_MS=10000
PG_STATEMENT_TIMEOUT_MS=10000
PG_LOCK_TIMEOUT_MS=5000
TRUST_PROXY=loopback
SERVIR_FRONTEND=
DIAGNOSTICO_PROXY=false
# DIAGNOSTICO_PROXY_HASTA=<fecha ISO-8601 futura; máximo 24 h en producción>
