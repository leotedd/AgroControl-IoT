# Plantilla: no contiene credenciales ni crea servicios.
NODE_ENV=production
DB_MOTOR=postgres
HOST=0.0.0.0
# PORT lo proporciona Render. No sustituirlo por PUERTO.
SERVIR_FRONTEND=../frontend/dist-real
TRUST_PROXY=loopback
# Medir el proxy antes de usar saltos:1, saltos:2 o saltos:3.
DIAGNOSTICO_PROXY=false
# DIAGNOSTICO_PROXY_HASTA=<fecha ISO-8601 futura, máximo 24 h>
CORS_ORIGENES=<origen HTTPS exacto autorizado>
DATABASE_URL=<URL del pooler Supabase en modo sesión>
DB_SSL=true
DB_SSL_CA=<CA PEM del proveedor; admite secuencias literales de salto de línea>
PG_POOL_MAX=5
PG_CONNECTION_TIMEOUT_MS=10000
PG_STATEMENT_TIMEOUT_MS=10000
PG_LOCK_TIMEOUT_MS=5000
JWT_SECRETO=<secreto NUEVO aleatorio de al menos 32 caracteres>
PERMITIR_ENCENDIDO=false
ENCENDIDO_MAX_S=5
IOT_PERMITIR_HTTP_LOCAL=false
LIMITES_DESACTIVADOS=false
# Usar sólo temporalmente durante el seed en una base vacía autorizada:
# DEMO_ADMIN_CONTRASENA=<secreto nuevo para la demostración, mínimo 16 caracteres>
